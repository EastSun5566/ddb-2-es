{
  "name": "ddb-2-es",
  "version": "0.0.3",
  "description": "🚚 Load streaming data into Amazon ES from DynamoDB by Lambda with latest ES bulk API",
  "main": "dist/index.js",
  "type": "module",
  "types": "dist/types/index.d.ts",
  "files": [
    "dist",
    "src"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsc",
    "lint": "oxlint",
    "test": "node --experimental-strip-types --experimental-test-module-mocks --test tests/index.test.ts",
    "prepublishOnly": "tsc",
    "release": "pnpm version && git push --follow-tags && pnpm publish"
  },
  "keywords": [
    "dynamodb",
    "streams",
    "elasticsearch",
    "bulk",
    "typescript"
  ],
  "author": "Michael Wang",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/EastSun5566/ddb-2-es"
  },
  "husky": {
    "hooks": {
      "pre-commit": "pnpm lint"
    }
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.162",
    "@types/node": "^22.10.5",
    "husky": "^9.1.7",
    "oxlint": "^1.73.0",
    "typescript": "^5.7.3"
  },
  "dependencies": {
    "@elastic/elasticsearch": "^9.4.2",
    "aws-elasticsearch-connector": "^9.2.0",
    "aws-sdk": "^2.1693.0"
  }
}
